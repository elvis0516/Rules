#!name=京东比价
#!desc=京东商品详情页显示慢慢买历史价格；首次使用需打开慢慢买App点“我的”获取ck
#!author=wf021325

[MITM]
hostname = %APPEND% in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com

[Script]
# —— 京东商品详情页注入慢慢买历史价格（http-response，改 body） ——
京东比价 = type=http-response,pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html,requires-body=1,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js
# —— 打开慢慢买App点“我的”时抓取 ck（http-request，读 body） ——
慢慢买ck = type=http-request,pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$,requires-body=1,script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js
